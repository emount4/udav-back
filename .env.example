# HTTP-порт и список разрешённых Origin через запятую.
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Файл JSON-логов. Относительный путь считается от рабочей папки.
LOG_FILE=logs/api.log

# Заполните при подключении соответствующих компонентов.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
CDN_BASE_URL=
TOKEN_SIGNING_KEY=
