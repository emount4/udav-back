# Внешний порт API и список разрешённых Origin через запятую.
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Файл JSON-логов. В Docker указывайте путь внутри logs/.
LOG_FILE=logs/api.log

# Настройки локальной базы в Docker Compose.
POSTGRES_USER=udav
POSTGRES_PASSWORD=udav_dev
POSTGRES_DB=udav

# При пустом значении Compose подключает API к контейнеру postgres.
DATABASE_URL=

# Заполните при подключении соответствующих компонентов.
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
CDN_BASE_URL=
TOKEN_SIGNING_KEY=
